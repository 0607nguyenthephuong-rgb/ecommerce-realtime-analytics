{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized cosmetics-store replay event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "event_id", "source_file", "source_row_number", "event_time", "emitted_at", "event_type", "product_id", "category_id", "category_code", "brand", "price", "user_id", "user_session", "quality_flags"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_file": {"type": "string", "minLength": 1},
    "source_row_number": {"type": "integer", "minimum": 1},
    "event_time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "emitted_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "event_type": {"enum": ["view", "cart", "remove_from_cart", "purchase"]},
    "product_id": {"type": "string", "pattern": "^[0-9]+$"},
    "category_id": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "category_code": {"type": ["string", "null"], "minLength": 1},
    "brand": {"type": ["string", "null"], "minLength": 1},
    "price": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "user_id": {"type": "string", "pattern": "^[0-9]+$"},
    "user_session": {"type": ["string", "null"], "minLength": 1},
    "quality_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["negative_price"]}}
  }
}

